#include <stdio.h>
#include <stdlib.h>

int main() {
    int **p = malloc(3 * sizeof(int*)); // 3 rows

    for (int i = 0; i < 3; i++){
        p[i] = malloc(3 * sizeof(int)); // 3 columns each
}
    // fill values
    p[0][0] = 10;
    p[1][1] = 20;
    p[2][2] = 30;

    printf("%d\n", p[1][1]);

    return 0;
}
