#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    char *str=(char*) calloc(10,1);  
    strcpy(str, "Hello678");    

    str[5] = '!';            
 
    printf("%s\n", str);      // Output: Hello!
    str=(char*)realloc(str,15);
    str[8]=' ';
    str[9]=' ';
    str[10]=' ';
    str[11]=' ';
    str[12]=' ';
    str[13] = 'a'; 
    str[14]='\0';
    printf("%s\n", str);
    printf("pointer memory %d\n",sizeof(str));    
    printf("datatype memoery %d",sizeof(*str));

    free(str);
    return 0;
}
